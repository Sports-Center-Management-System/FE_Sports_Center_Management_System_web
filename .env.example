# Leave blank for Vite same-origin proxy to http://localhost:3000.
VITE_API_BASE_URL=
# Public URL of the forwarded web port for the QR demo, e.g. https://your-tunnel.example.com
VITE_PUBLIC_WEB_URL=
# Enable only in a demo build. Vite dev mode shows the page automatically.
VITE_ENABLE_MOCK_PAYMENT=false
